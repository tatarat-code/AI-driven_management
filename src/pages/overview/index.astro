---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import RouteMap from '../../components/RouteMap.astro';
import { LINES } from '../../data/home';

const all = (await getCollection('overview')).sort((a, b) => a.data.order - b.data.order);
const intro = all.find((c) => c.data.order === 0);
const appendix = all.find((c) => c.data.order === 99);
const chapters = all.filter((c) => c.data.order >= 1 && c.data.order <= 15);
const groups = LINES.map((l) => ({ ...l, items: chapters.filter((c) => l.chapters.includes(c.data.order)) }));
const shortTitle = (t: string) => t.replace(/^第\d+章\s*/, '');
const linkOf = (c: { id: string; data: { status: string } }) => (c.data.status === 'published' ? `/overview/${c.id}/` : undefined);
---

<BaseLayout title="概要版" full>
  <PageHeader
    kicker="OVERVIEW"
    title="概要版"
    lead="はじめに・全15章・付録。1章あたりA4で4〜6ページで、講義全体を見渡すための教材です。各章は詳細ガイドブックの同じ番号の巻で深められます。"
    crumbs={[{ label: '概要版' }]}
  />

  <div class="container section-gap">
    <RouteMap />

    <div class="side-entries">
      {[intro, appendix].filter(Boolean).map((c) => (
        <div class="side-entry">
          {linkOf(c!) ? <a href={linkOf(c!)}>{c!.data.title}</a> : <span>{c!.data.title}</span>}
          {c!.data.status !== 'published' && <span class="badge">準備中</span>}
          {c!.data.pdf && <a class="pdf" href={c!.data.pdf}>PDF</a>}
        </div>
      ))}
    </div>

    <div class="groups">
      {groups.map((g) => (
        <section class="group" style={`--line-color:${g.color}`}>
          <h2 class="group-title"><span class="swatch"></span>{g.name}</h2>
          <ol class="chapter-list">
            {g.items.map((c) => (
              <li class="chapter">
                <span class="chapter-no">{String(c.data.order).padStart(2, '0')}</span>
                <div class="chapter-body">
                  {linkOf(c)
                    ? <a class="chapter-title" href={linkOf(c)}>{shortTitle(c.data.title)}</a>
                    : <span class="chapter-title">{shortTitle(c.data.title)}</span>}
                  {c.data.summary && <p class="chapter-summary">{c.data.summary}</p>}
                </div>
                <div class="chapter-meta">
                  {c.data.status === 'published' ? <span class="badge badge-ok">公開中</span> : <span class="badge">準備中</span>}
                  {c.data.pdf && <a class="pdf" href={c.data.pdf}>PDF</a>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .side-entries { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .side-entry { display: inline-flex; align-items: center; gap: 10px; background: var(--paper); border: 1px solid var(--line); border-radius: 999px; padding: 8px 18px; font-weight: 700; }
  .groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 20px; margin-top: 40px; }
  .group { background: var(--paper); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; border-top: 8px solid var(--line-color); }
  .group-title { margin: 0; padding: 16px 20px 8px; font-size: 18px; font-weight: 900; display: flex; align-items: center; gap: 10px; }
  .swatch { width: 24px; height: 8px; border-radius: 4px; background: var(--line-color); }
  .chapter-list { list-style: none; margin: 0; padding: 0 20px 12px; }
  .chapter { display: grid; grid-template-columns: 40px 1fr auto; gap: 12px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid #EEF2F7; }
  .chapter:last-child { border-bottom: none; }
  .chapter-no { font-family: var(--font-num); font-weight: 700; font-size: 18px; color: var(--line-color); }
  .chapter-title { font-weight: 700; color: var(--ink); }
  a.chapter-title { color: var(--navy); }
  .chapter-summary { margin: 4px 0 0; font-size: 14px; color: var(--muted); }
  .chapter-meta { display: flex; gap: 8px; align-items: center; }
  .pdf { font-family: var(--font-num); font-size: 13px; font-weight: 700; }
</style>
