---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 公開済み（status: published）の巻だけページを作る
export async function getStaticPaths() {
  const vols = await getCollection('guidebook', (v) => v.data.status === 'published');
  return vols.map((v) => ({ params: { id: v.id }, props: { v } }));
}

const { v } = Astro.props;
const { Content } = await render(v);
---

<BaseLayout title={`第${v.data.volume}巻 ${v.data.title}`} description={v.data.summary}>
  <p class="breadcrumb">
    <a href="/">トップ</a> ＞ <a href="/guidebook/">詳細ガイドブック</a> ＞ 第{v.data.volume}巻
  </p>
  <article>
    <h1>第{v.data.volume}巻 {v.data.title}</h1>
    {v.data.pdf && <p><a href={v.data.pdf}>PDF版をダウンロード</a></p>}
    <Content />
  </article>
</BaseLayout>
