---
// トップページ：インフォグラフィックLP（デザイン案A＋C「設計図×路線図」）
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteMap from '../components/RouteMap.astro';
import { SITE } from '../site';
import {
  STATS, MATURITY, COMPANIES, ROIC_SCALE_MAX,
} from '../data/home';

// 新着情報（新しい順に5件）
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const pct = (v: number) => `${((v / ROIC_SCALE_MAX) * 100).toFixed(1)}%`;
const barColors = ['#8FA8C3', '#3F6189', '#1B3A5C'];
---

<BaseLayout full>
  <!-- 1. ヒーロー -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">{SITE.owner}｜2027年度 前期</p>
        <h1 class="hero-title">財務の言葉で、<br />AIと経営をつなぐ。</h1>
        <p class="hero-lead">
          生成AIやAIエージェントの導入を「便利になった」で終わらせず、利益と資本の効率（ROIC）に結びつけて考える。講義「企業経営とAI」の教材を公開しています。
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/overview/">概要版を読む</a>
          <a class="btn btn-secondary" href="/guidebook/">詳細ガイドブック（全15巻）</a>
        </div>
      </div>

      <figure class="roic-tree">
        <figcaption>図：ROICツリー ― AIはどの枝に効くか</figcaption>
        <div class="tree">
          <div class="tree-root">
            <span class="tree-root-name">ROIC</span>
            <span class="tree-root-sub">投下資本利益率</span>
          </div>
          <div class="v-line"></div>
          <div class="h-line"></div>
          <div class="tree-branches">
            <div class="branch">
              <div class="v-line"></div>
              <div class="branch-node">売上高営業利益率</div>
              <div class="v-line v-line-soft"></div>
              <div class="leaves">
                <div class="leaf"><span class="leaf-name">粗利率</span><span class="tag">B社</span></div>
                <div class="leaf"><span class="leaf-name">販管費率</span></div>
              </div>
            </div>
            <div class="branch">
              <div class="v-line"></div>
              <div class="branch-node">投下資本回転率</div>
              <div class="v-line v-line-soft"></div>
              <div class="leaves">
                <div class="leaf"><span class="leaf-name">運転資本</span><span class="tag">A社</span></div>
                <div class="leaf"><span class="leaf-name">固定資産・稼働率</span><span class="tag">C社</span></div>
              </div>
            </div>
          </div>
        </div>
        <p class="note">A社・B社・C社は、ROICが下がる原因の枝がそれぞれ違う模擬企業（架空）です。</p>
      </figure>
    </div>
  </section>

  <!-- 2. 講義の数字 -->
  <section class="stats" aria-label="講義の数字">
    <div class="container stats-inner">
      {STATS.map((s) => (
        <div class="stat">
          <div class="stat-value">{s.value}<span class="stat-unit">{s.unit}</span></div>
          <div class="stat-note">{s.note}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. AX成熟度 -->
  <section class="container block">
    <p class="kicker">AX成熟度</p>
    <h2 class="block-title">AIの使い方は、5つの段階で深まる</h2>
    <p class="block-lead">個人がチャットで使う段階から、業務の流れそのものを作り直す段階まで。自社がいまどこにいるかを診断し、次の一段を計画します。</p>
    <ol class="steps">
      {MATURITY.map((m) => (
        <li class="step" style={`background:${m.bg};color:${m.fg};--h:${m.h}px`}>
          <span class="step-no" style={`color:${m.num}`}>{m.level}</span>
          <span class="step-name">{m.name}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- 4. 学びの路線図（15章） -->
  <section class="container block" id="route">
    <p class="kicker">学びの路線図</p>
    <h2 class="block-title">15章を、5つの路線でたどる</h2>
    <p class="block-lead">どの路線から乗っても、第4章「会計を共通言語に」で財務ハブ線に乗り換え、終点の第15章でAX計画書を書き上げます。各駅は概要版でつかみ、詳細ガイドブックで深めます。</p>
    <RouteMap />
  </section>

  <!-- 5. 模擬企業3社 -->
  <section class="container block">
    <p class="kicker">模擬企業3社</p>
    <h2 class="block-title">ROICが下がる理由は、会社ごとに違う</h2>
    <p class="block-lead">同じ「利益率の低下」でも、原因の枝が違えば、効くAIの使い方も違います。3社のROICの推移（3時点）を見比べます。</p>
    <div class="companies">
      {COMPANIES.map((c) => (
        <div class="company">
          <div>
            <div class="company-name">{c.name}</div>
            <div class="company-profile">{c.profile}</div>
          </div>
          <div class="bars" role="img" aria-label={`${c.name}のROIC：${c.roic.join('%、')}%`}>
            {c.roic.map((v, i) => (
              <div class="bar-row">
                <div class="bar" style={`width:${pct(v)};background:${barColors[i]}`}></div>
                <span class="bar-value">{v.toFixed(1)}%</span>
              </div>
            ))}
          </div>
          <div class="company-cause">原因の枝：<strong>{c.cause}</strong></div>
        </div>
      ))}
    </div>
    <p class="note">3社はいずれも教材のための模擬企業（架空）です。数値は教材の検算スクリプトの値です。</p>
  </section>

  <!-- 6. 教材の使い方 -->
  <section class="container block">
    <p class="kicker">教材の使い方</p>
    <h2 class="block-title">つかむ → 深める → 計画する</h2>
    <div class="flow">
      <a class="flow-card" href="/overview/">
        <span class="flow-step">STEP 1</span>
        <span class="flow-name">概要版</span>
        <span class="flow-desc">はじめに・全15章・付録。1章あたりA4で4〜6ページ。講義全体を見渡す。</span>
      </a>
      <a class="flow-card" href="/guidebook/">
        <span class="flow-step">STEP 2</span>
        <span class="flow-name">詳細ガイドブック</span>
        <span class="flow-desc">全15巻。1巻あたり25〜40ページ。事例と演習で各章を深める。</span>
      </a>
      <a class="flow-card flow-card-dark" href="/syllabus/">
        <span class="flow-step">STEP 3</span>
        <span class="flow-name">AX計画書</span>
        <span class="flow-desc">学んだ型を使い、自社または模擬企業のAX計画を、財務の数字で書き上げる。</span>
      </a>
    </div>
  </section>

  <!-- 7. 新着情報 -->
  <section class="container block block-last" id="news">
    <div class="news-head">
      <h2 class="block-title">新着情報</h2>
      <a href="/news/">一覧を見る</a>
    </div>
    <ul class="news-list">
      {news.map((n) => (
        <li>
          <span class="news-date">{fmt(n.data.date)}</span>
          {n.data.link ? <a href={n.data.link}>{n.data.title}</a> : <span>{n.data.title}</span>}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    background-color: var(--paper);
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    border-bottom: 1px solid var(--line);
  }
  .hero-inner { padding-top: 80px; padding-bottom: 88px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr)); gap: 56px; align-items: center; }
  .hero-text { display: flex; flex-direction: column; gap: 24px; }
  .eyebrow { margin: 0; font-size: 14px; font-weight: 700; letter-spacing: 0.08em; color: var(--navy); }
  .hero-title { margin: 0; font-weight: 900; font-size: clamp(36px, 6vw, 56px); line-height: 1.3; text-wrap: balance; }
  .hero-lead { margin: 0; font-size: 18px; color: var(--ink-soft); max-width: 34em; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .roic-tree { margin: 0; background: var(--paper); border: 1px solid #C9D4E0; border-radius: 16px; padding: 32px; box-shadow: 0 24px 48px -24px rgba(20, 32, 46, 0.25); }
  .roic-tree figcaption { font-size: 13px; font-weight: 700; color: var(--muted); letter-spacing: 0.06em; margin-bottom: 20px; }
  .tree { display: flex; flex-direction: column; align-items: center; }
  .tree-root { background: var(--navy); color: #fff; border-radius: 10px; padding: 14px 28px; text-align: center; display: flex; flex-direction: column; }
  .tree-root-name { font-family: var(--font-num); font-weight: 700; font-size: 28px; line-height: 1.2; }
  .tree-root-sub { font-size: 13px; }
  .v-line { width: 2px; height: 20px; background: var(--navy); }
  .v-line-soft { height: 16px; background: #8FA3B8; }
  .h-line { width: 50%; height: 2px; background: var(--navy); }
  .tree-branches { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; width: 100%; }
  .branch { display: flex; flex-direction: column; align-items: center; }
  .branch-node { border: 2px solid var(--navy); border-radius: 10px; padding: 10px 12px; text-align: center; font-weight: 700; font-size: 15px; width: 100%; }
  .leaves { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; width: 100%; }
  .leaf { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .leaf-name { background: #EEF2F7; border-radius: 8px; padding: 8px; text-align: center; font-size: 14px; width: 100%; }
  .tag { font-size: 12px; font-weight: 700; color: #fff; background: var(--accent); border-radius: 999px; padding: 2px 10px; }

  .stats { background: var(--navy); color: #fff; }
  .stats-inner { padding-top: 40px; padding-bottom: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 24px; }
  .stat { display: flex; flex-direction: column; gap: 4px; }
  .stat-value { font-family: var(--font-num); font-weight: 700; font-size: 48px; line-height: 1.1; }
  .stat-unit { font-family: var(--font-body); font-size: 20px; margin-left: 4px; }
  .stat-note { font-size: 14px; color: #D3DEEA; }

  .block { padding-top: 88px; }
  .block-last { padding-bottom: 96px; }
  .block-title { margin: 8px 0 12px; font-weight: 900; font-size: clamp(26px, 4vw, 36px); }
  .block-lead { margin: 0 0 36px; color: var(--ink-soft); max-width: 40em; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 12px; align-items: end; }
  .step { min-height: var(--h); border-radius: 12px 12px 4px 4px; padding: 20px; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px; }
  .step-no { font-family: var(--font-num); font-weight: 700; font-size: 32px; line-height: 1; }
  .step-name { font-weight: 700; font-size: 18px; }

  .companies { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 20px; }
  .company { background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 24px; display: flex; flex-direction: column; gap: 16px; }
  .company-name { font-family: var(--font-head); font-weight: 900; font-size: 22px; }
  .company-profile { font-size: 14px; color: var(--muted); }
  .bars { display: flex; flex-direction: column; gap: 8px; }
  .bar-row { display: flex; align-items: center; gap: 12px; }
  .bar { height: 20px; border-radius: 4px; }
  .bar-value { font-family: var(--font-num); font-weight: 700; }
  .company-cause { border-top: 1px solid var(--grid); padding-top: 12px; font-size: 15px; }

  .flow { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 20px; margin-top: 28px; }
  .flow-card { display: flex; flex-direction: column; gap: 8px; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 28px; text-decoration: none; color: var(--ink); }
  .flow-card:hover { border-color: var(--navy); color: var(--ink); }
  .flow-card-dark { background: var(--navy); border-color: var(--navy); color: #fff; }
  .flow-card-dark:hover { color: #fff; background: var(--navy-deep); }
  .flow-step { font-family: var(--font-num); font-weight: 700; font-size: 14px; color: var(--accent); }
  .flow-card-dark .flow-step { color: #F3C29E; }
  .flow-name { font-family: var(--font-head); font-weight: 900; font-size: 24px; }
  .flow-desc { font-size: 15px; color: var(--ink-soft); }
  .flow-card-dark .flow-desc { color: #D3DEEA; }

  .news-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .news-head .block-title { margin: 0; }
  .news-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .news-list li { display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .news-list .news-date { min-width: 7em; margin-right: 0; }

  @media (max-width: 640px) {
    .step { min-height: 0; flex-direction: row; justify-content: flex-start; align-items: baseline; gap: 12px; padding: 14px 20px; border-radius: 8px; }
    .hero-inner { padding-top: 48px; padding-bottom: 56px; }
    .block { padding-top: 64px; }
  }
</style>
