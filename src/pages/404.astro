---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="ページが見つかりません" full>
  <PageHeader
    kicker="404"
    title="ページが見つかりません"
    lead="お探しのページは移動したか、まだ公開されていない可能性があります。"
  >
    <div class="actions">
      <a class="btn btn-primary" href="/">トップページへ</a>
      <a class="btn btn-secondary" href="/overview/">概要版の一覧へ</a>
    </div>
  </PageHeader>
  <div class="spacer"></div>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  .spacer { height: 120px; }
</style>
